{
  "name": "@jakeryderv/pi-agent-bridge",
  "version": "0.1.0",
  "description": "A Pi extension that delegates work to official external coding-agent runtimes.",
  "type": "module",
  "license": "MIT",
  "author": "Jake Van Slyke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakeryderv/pi-agent-bridge.git"
  },
  "homepage": "https://github.com/jakeryderv/pi-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/jakeryderv/pi-agent-bridge/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "codex",
    "claude-code",
    "subagent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run pack:check",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "smoke:pi": "npm run build --silent && tsx scripts/smoke-pi.ts",
    "prepack": "npm run clean && npm run build && npm run pack:check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.240",
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typebox": "^1.3.16",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
